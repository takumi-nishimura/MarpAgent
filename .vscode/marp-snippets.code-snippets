{
  "MarpInit": {
    "prefix": "marp",
    "scope": "markdown",
    "body": [
      "---",
      "marp: true",
      "theme: lab",
      "class: normal",
      "paginate: true",
      "transition: slide",
      "style: |",
      "  section {",
      "    --logos-dark: url(shared/logos/marp-logo.svg);",
      "    --logos-light: url(shared/logos/marp-logo.svg);",
      "  }",
      "---",
    ],
    "description": "Initialize Marp frontmatter",
  },
  "TwoColumns": {
    "prefix": "col",
    "scope": "markdown",
    "body": [
      "<div class=\"col\">",
      "<div>",
      "",
      "${1:left}",
      "",
      "</div>",
      "<div>",
      "",
      "${2:right}",
      "",
      "</div>",
      "</div>",
    ],
    "description": "Two-column layout",
  },
  "Image": {
    "prefix": "image",
    "scope": "markdown",
    "body": [
      "<figure>",
      "<img src=\"${1:path}\" />",
      "<figcaption>${2:caption}</figcaption>",
      "</figure>",
    ],
    "description": "Image element with caption",
  },
  "Video": {
    "prefix": "video",
    "scope": "markdown",
    "body": [
      "<figure>",
      "<video src=\"${1:path}\" muted autoplay controls loop></video>",
      "<figcaption>${2:caption}</figcaption>",
      "</figure>",
    ],
    "description": "Video figure with controls",
  },
  "InfoBlock": {
    "prefix": "info",
    "scope": "markdown",
    "body": ["<div class=\"info\">", "", "${1:content}", "", "</div>"],
    "description": "Info block for title slides",
  },
  "NoteAlert": {
    "prefix": "note",
    "scope": "markdown",
    "body": ["> [!NOTE]", "> ${1:content}"],
    "description": "Note callout (GFM alert)",
  },
  "TipAlert": {
    "prefix": "tip",
    "scope": "markdown",
    "body": ["> [!TIP]", "> ${1:content}"],
    "description": "Tip callout (GFM alert)",
  },
  "ImportantAlert": {
    "prefix": "important",
    "scope": "markdown",
    "body": ["> [!IMPORTANT]", "> ${1:content}"],
    "description": "Important callout (GFM alert)",
  },
  "WarningAlert": {
    "prefix": "warning",
    "scope": "markdown",
    "body": ["> [!WARNING]", "> ${1:content}"],
    "description": "Warning callout (GFM alert)",
  },
  "CautionAlert": {
    "prefix": "caution",
    "scope": "markdown",
    "body": ["> [!CAUTION]", "> ${1:content}"],
    "description": "Caution callout (GFM alert)",
  },
  "NoteCalloutHtml": {
    "prefix": "html-note",
    "scope": "markdown",
    "body": ["<div class=\"note\">", "", "${1:content}", "", "</div>"],
    "description": "Note callout (HTML form — use when body contains markdown that breaks inside a blockquote)",
  },
  "TipCalloutHtml": {
    "prefix": "html-tip",
    "scope": "markdown",
    "body": ["<div class=\"tip\">", "", "${1:content}", "", "</div>"],
    "description": "Tip callout (HTML form)",
  },
  "ImportantCalloutHtml": {
    "prefix": "html-important",
    "scope": "markdown",
    "body": ["<div class=\"important\">", "", "${1:content}", "", "</div>"],
    "description": "Important callout (HTML form)",
  },
  "WarningCalloutHtml": {
    "prefix": "html-warning",
    "scope": "markdown",
    "body": ["<div class=\"warning\">", "", "${1:content}", "", "</div>"],
    "description": "Warning callout (HTML form)",
  },
  "CautionCalloutHtml": {
    "prefix": "html-caution",
    "scope": "markdown",
    "body": ["<div class=\"caution\">", "", "${1:content}", "", "</div>"],
    "description": "Caution callout (HTML form)",
  },
  "PresenterNote": {
    "prefix": "pnote",
    "scope": "markdown",
    "body": "<!-- ${1:note} -->",
    "description": "Presenter note (HTML comment)",
  },
  "NewPage": {
    "prefix": "page",
    "scope": "markdown",
    "body": [
      "",
      "---",
      "",
      "<!-- _header: ${1:Header} -->",
      "",
      "## ${2:Chapter}",
      "",
      "${0}",
    ],
    "description": "New content slide with header",
  },
  "Footnote": {
    "prefix": "footnote",
    "scope": "markdown",
    "body": ["<div class=\"footnote\">", "", "${1:reference}", "", "</div>"],
    "description": "Footnote reference at bottom of slide",
  },
  "TitlePage": {
    "prefix": "title",
    "scope": "markdown",
    "body": [
      "",
      "<!-- _paginate: skip -->",
      "<!-- _class: title -->",
      "<!-- _header: ${1:date} -->",
      "",
      "# ${2:Title}",
      "",
      "<div class=\"author\">",
      "",
      "${3:affiliation}",
      "",
      "</div>",
      "",
    ],
    "description": "Title slide page",
  },
}
