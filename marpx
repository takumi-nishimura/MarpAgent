#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$repo_root"

if ! command -v mise >/dev/null 2>&1; then
  echo "Error: mise is required to run MarpAgent. Install mise or use npm run marpx -- directly with Node.js 25.x." >&2
  exit 127
fi

MISE_LOG_LEVEL="${MISE_LOG_LEVEL:-error}" exec mise exec -- npm run --silent marpx -- "$@"
